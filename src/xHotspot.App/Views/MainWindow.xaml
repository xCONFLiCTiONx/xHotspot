<Window x:Class="xHotspot.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:xHotspot.App.ViewModels"
        mc:Ignorable="d"
        Title="xHotspot — Always-On Mobile Hotspot Manager" Height="360" Width="420"
        Background="#1E1E1E" Foreground="White" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,6"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E3E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="xHotspot" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Always-On Mobile Hotspot Manager" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,15"/>

            <Border Background="#252526" CornerRadius="8" Padding="15" BorderBrush="#333333" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Mode:" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <TextBlock Text="{Binding AutomationStatusText}" HorizontalAlignment="Right" Foreground="#2196F3" FontWeight="Bold"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Configured Phone:" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <TextBlock Text="{Binding PhoneName}" HorizontalAlignment="Right" Foreground="#4CAF50" FontWeight="Bold"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Network / Wi-Fi:" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <TextBlock Text="{Binding WifiSsid}" HorizontalAlignment="Right" Foreground="White"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Mobile Hotspot:" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                        <TextBlock Text="{Binding HotspotStatus}" HorizontalAlignment="Right" Foreground="#FF9800" FontWeight="Bold"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,15,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Foreground="#2196F3" Background="#333333" BorderThickness="0"/>

            <Grid HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="{Binding ToggleButtonText}"
                        Command="{Binding ToggleHotspotCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Width="280" Height="40" FontSize="14" FontWeight="SemiBold"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
